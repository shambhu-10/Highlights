{
  "manifest_version": 3,
  "name": "Highlights",
  "version": "0.1.0",
  "description": "Highlight the web. Find it again.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "identity", "alarms", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlights",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "highlight": {
      "suggested_key": { "default": "Alt+H", "mac": "MacCtrl+Shift+H" },
      "description": "Highlight the selected text"
    }
  }
}
